<Window
    x:Class="Usage4Claude.WinUI.Tray.TrayDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Usage4Claude.WinUI.Controls"
    Title="Usage4Claude Detail">
    <Grid x:Name="DragSurface"
          Padding="14"
          Width="336"
          RowSpacing="10"
          Background="Transparent"
          PointerCanceled="DragSurface_PointerDragEnded"
          PointerCaptureLost="DragSurface_PointerCaptureLost"
          PointerMoved="DragSurface_PointerMoved"
          PointerPressed="DragSurface_PointerPressed"
          PointerReleased="DragSurface_PointerDragEnded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Usage4Claude" />
                <TextBlock x:Name="UpdatedAtText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Sign in and refresh usage" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        Click="RefreshUsage_Click" />
                <Button Content="Open"
                        Click="OpenProbe_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <Border Padding="10"
                        CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Claude" />
                            <TextBlock x:Name="ClaudeEmptyText" Text="Not signed in" />
                            <StackPanel x:Name="ClaudeUsagePanel" Spacing="6" Visibility="Collapsed">
                                <controls:CircularUsageRing x:Name="ClaudeRing"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,4,0,4" />
                                <Grid x:Name="ClaudePrimaryRow" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="5-hour" VerticalAlignment="Center" />
                                        <ProgressBar x:Name="ClaudePrimaryBar"
                                                     Grid.Column="1"
                                                     Maximum="100"
                                                     Height="6"
                                                     VerticalAlignment="Center" />
                                        <TextBlock x:Name="ClaudePrimaryText"
                                                   Grid.Column="2"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="ClaudePrimaryResetText"
                                               Grid.Row="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid x:Name="ClaudeSecondaryRow" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="7-day" VerticalAlignment="Center" />
                                        <ProgressBar x:Name="ClaudeSecondaryBar"
                                                     Grid.Column="1"
                                                     Maximum="100"
                                                     Height="6"
                                                     VerticalAlignment="Center" />
                                        <TextBlock x:Name="ClaudeSecondaryText"
                                                   Grid.Column="2"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="ClaudeSecondaryResetText"
                                               Grid.Row="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid x:Name="ClaudeExtraRow" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Extra Usage" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="ClaudeExtraBar"
                                                 Grid.Column="1"
                                                 Maximum="100"
                                                 Height="6"
                                                 VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClaudeExtraText"
                                               Grid.Column="2"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="ClaudeOpusRow" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Opus" VerticalAlignment="Center" />
                                        <ProgressBar x:Name="ClaudeOpusBar"
                                                     Grid.Column="1"
                                                     Maximum="100"
                                                     Height="6"
                                                     VerticalAlignment="Center" />
                                        <TextBlock x:Name="ClaudeOpusText"
                                                   Grid.Column="2"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="ClaudeOpusResetText"
                                               Grid.Row="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid x:Name="ClaudeSonnetRow" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sonnet" VerticalAlignment="Center" />
                                        <ProgressBar x:Name="ClaudeSonnetBar"
                                                     Grid.Column="1"
                                                     Maximum="100"
                                                     Height="6"
                                                     VerticalAlignment="Center" />
                                        <TextBlock x:Name="ClaudeSonnetText"
                                                   Grid.Column="2"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="ClaudeSonnetResetText"
                                               Grid.Row="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="10"
                        CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Codex" />
                            <TextBlock x:Name="CodexEmptyText" Text="Not signed in" />
                            <StackPanel x:Name="CodexUsagePanel" Spacing="6" Visibility="Collapsed">
                                <Grid x:Name="CodexPrimaryRow" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Primary" VerticalAlignment="Center" />
                                        <ProgressBar x:Name="CodexPrimaryBar"
                                                     Grid.Column="1"
                                                     Maximum="100"
                                                     Height="6"
                                                     VerticalAlignment="Center" />
                                        <TextBlock x:Name="CodexPrimaryText"
                                                   Grid.Column="2"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="CodexPrimaryResetText"
                                               Grid.Row="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid x:Name="CodexSecondaryRow" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Secondary" VerticalAlignment="Center" />
                                        <ProgressBar x:Name="CodexSecondaryBar"
                                                     Grid.Column="1"
                                                     Maximum="100"
                                                     Height="6"
                                                     VerticalAlignment="Center" />
                                        <TextBlock x:Name="CodexSecondaryText"
                                                   Grid.Column="2"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="CodexSecondaryResetText"
                                               Grid.Row="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid x:Name="CodexCreditsRow" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Credits" />
                                    <TextBlock x:Name="CodexCreditsText" Grid.Column="1" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="UsageModeRadio"
                                 Content="Usage"
                                 GroupName="ProgressMode"
                                 IsChecked="True"
                                 Checked="ProgressMode_Changed" />
                    <RadioButton x:Name="TimeModeRadio"
                                 Content="Time elapsed"
                                 GroupName="ProgressMode"
                                 Checked="ProgressMode_Changed" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch x:Name="TopMostToggle"
                                 Header="TopMost"
                                 ToolTipService.ToolTip="TopMost"
                                 Toggled="TopMostToggle_Toggled" />
                    <Button Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Content="Hide detail"
                            Click="HideDetail_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
