<Window
    x:Class="Usage4Claude.WinUI.Tray.TrayDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Usage4Claude Detail">
    <Grid Padding="14" Width="320">
        <StackPanel Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Usage4Claude" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Notification area detail prototype" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Open"
                        Click="OpenProbe_Click" />
            </Grid>

            <Border Padding="10"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="Claude" />
                        <TextBlock Text="Browser-backed probe validated" />
                    </StackPanel>
                    <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="True" />
                </Grid>
            </Border>

            <Border Padding="10"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="Codex" />
                        <TextBlock Text="Browser-backed probe validated" />
                    </StackPanel>
                    <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="True" />
                </Grid>
            </Border>

            <Button HorizontalAlignment="Stretch"
                    Content="Hide detail"
                    Click="HideDetail_Click" />
        </StackPanel>
    </Grid>
</Window>
