<UserControl
    x:Class="Usage4Claude.WinUI.Controls.CircularUsageRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid Width="120" Height="120">
        <canvas:CanvasControl x:Name="RingCanvas"
                              ClearColor="Transparent"
                              Draw="RingCanvas_Draw"
                              PointerMoved="RingCanvas_PointerMoved"
                              PointerExited="RingCanvas_PointerExited" />
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="1">
            <TextBlock x:Name="PrimaryPercentText"
                       Text="--"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
            <TextBlock Text="5-hour"
                       FontSize="10"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Popup x:Name="RingTooltipPopup">
            <Border Background="#B3FFFFFF"
                    CornerRadius="6"
                    Padding="8,5">
                <TextBlock x:Name="RingTooltipText"
                           FontSize="12"
                           Foreground="Black" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
